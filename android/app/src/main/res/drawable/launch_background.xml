<?xml version="1.0" encoding="utf-8"?>
<!-- Before Android 12: the launch window shows Echo asleep, centred on the
     welcome screen's ground, as the app's first frame does (see LaunchEcho). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_echo" />
    </item>
</layer-list>
