<?xml version="1.0" encoding="utf-8"?>
<!-- Next to-do (4×1), Android 12+ with a real CheckBox: the next thing on the list and when, with a tick. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/next_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_todo_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <CheckBox
        android:id="@+id/next_check"
        style="@style/TodoRowCheckBox" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/next_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Next to-do"
            android:textColor="@color/todo_widget_text2"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Send Karan the deck"
            android:textColor="@color/todo_widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_sub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/todo_widget_text2"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/next_due_box"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:gravity="end"
        android:orientation="vertical">

        <TextView
            android:id="@+id/next_due"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="6 PM"
            android:textColor="@color/todo_widget_green"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/next_due_small"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="in 30 min"
            android:textColor="@color/todo_widget_text2"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/next_done"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/todo_check_on"
        android:visibility="gone" />
</LinearLayout>
