<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: the system splash. Echo asleep on the welcome screen's
         ground; the app's first frame is this same picture (see LaunchEcho),
         so the hand-over can't be seen. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_ground</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_echo</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
