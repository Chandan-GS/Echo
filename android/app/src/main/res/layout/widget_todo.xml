<?xml version="1.0" encoding="utf-8"?>
<!-- Echo To-do (4×3): today's list with the waveform as the progress meter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_todo_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/todo_orb"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/todo_day"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/old_standard_tt_bold"
                android:includeFontPadding="false"
                android:text="Saturday"
                android:textColor="@color/todo_widget_text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/todo_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="26 September"
                android:textColor="@color/todo_widget_text2"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/todo_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/old_standard_tt_bold"
                android:includeFontPadding="false"
                android:text="2/5"
                android:textColor="@color/todo_widget_green"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/todo_left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="3 left"
                android:textColor="@color/todo_widget_text2"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <ImageView
        android:id="@+id/todo_wave"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        android:scaleType="fitXY" />

    <!-- Shown when there's no list yet -->
    <TextView
        android:id="@+id/todo_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="No list yet. Open today's briefing and tap Make a to-do list at the end."
        android:textColor="@color/todo_widget_text2"
        android:textSize="13sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/todo_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_todo_next_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/todo_next_when"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 PM · in 2h 53m"
                android:textColor="@color/todo_widget_green"
                android:textSize="12.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/todo_next_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Join Team sync"
                android:textColor="@color/todo_widget_text"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageView
            android:id="@+id/todo_next_check"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="10dp"
            android:contentDescription="Mark done" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/todo_row1"
        style="@style/TodoRow">
        <ImageView android:id="@+id/todo_row1_check" style="@style/TodoRowCheck" />
        <TextView android:id="@+id/todo_row1_title" style="@style/TodoRowTitle" />
        <TextView android:id="@+id/todo_row1_time" style="@style/TodoRowTime" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/todo_row2"
        style="@style/TodoRow">
        <ImageView android:id="@+id/todo_row2_check" style="@style/TodoRowCheck" />
        <TextView android:id="@+id/todo_row2_title" style="@style/TodoRowTitle" />
        <TextView android:id="@+id/todo_row2_time" style="@style/TodoRowTime" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/todo_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/todo_widget_text2"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todo_tomorrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/todo_widget_text2"
            android:textSize="11.5sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
