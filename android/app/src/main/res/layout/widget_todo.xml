<?xml version="1.0" encoding="utf-8"?>
<!-- Echo To-do (4×3): today's list, unfinished first. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/todo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_todo_bg"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingTop="16dp"
    android:paddingEnd="18dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/old_standard_tt_bold"
            android:includeFontPadding="false"
            android:text="Today"
            android:textColor="@color/todo_widget_text"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/todo_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Sat 26 Sep"
            android:textColor="@color/todo_widget_text2"
            android:textSize="12.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todo_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 left"
            android:textColor="@color/todo_widget_green"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/todo_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:textColor="@color/todo_widget_text2"
        android:textSize="13.5sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/todo_done"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <ImageView
            android:id="@+id/todo_done_badge"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:importantForAccessibility="no" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="That's everything for today"
                android:textColor="@color/todo_widget_text"
                android:textSize="14.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/todo_done_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/todo_widget_text2"
                android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/todo_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">

    <LinearLayout
        android:id="@+id/todo_row1"
        style="@style/TodoRow">
        <ImageView
            android:id="@+id/todo_row1_check"
            style="@style/TodoRowCheck" />
        <TextView
            android:id="@+id/todo_row1_title"
            style="@style/TodoRowTitle" />
        <TextView
            android:id="@+id/todo_row1_time"
            style="@style/TodoRowTime" />
    </LinearLayout>
    <View
        android:id="@+id/todo_div2"
        style="@style/TodoDivider" />
    <LinearLayout
        android:id="@+id/todo_row2"
        style="@style/TodoRow">
        <ImageView
            android:id="@+id/todo_row2_check"
            style="@style/TodoRowCheck" />
        <TextView
            android:id="@+id/todo_row2_title"
            style="@style/TodoRowTitle" />
        <TextView
            android:id="@+id/todo_row2_time"
            style="@style/TodoRowTime" />
    </LinearLayout>
    <View
        android:id="@+id/todo_div3"
        style="@style/TodoDivider" />
    <LinearLayout
        android:id="@+id/todo_row3"
        style="@style/TodoRow">
        <ImageView
            android:id="@+id/todo_row3_check"
            style="@style/TodoRowCheck" />
        <TextView
            android:id="@+id/todo_row3_title"
            style="@style/TodoRowTitle" />
        <TextView
            android:id="@+id/todo_row3_time"
            style="@style/TodoRowTime" />
    </LinearLayout>
    <View
        android:id="@+id/todo_div4"
        style="@style/TodoDivider" />
    <LinearLayout
        android:id="@+id/todo_row4"
        style="@style/TodoRow">
        <ImageView
            android:id="@+id/todo_row4_check"
            style="@style/TodoRowCheck" />
        <TextView
            android:id="@+id/todo_row4_title"
            style="@style/TodoRowTitle" />
        <TextView
            android:id="@+id/todo_row4_time"
            style="@style/TodoRowTime" />
    </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/todo_more"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/todo_widget_text2"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/todo_tomorrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/todo_widget_text2"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
