<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/widget_today_bg"
    android:padding="20dp">

    <TextView
        android:id="@+id/widget_today_num"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="6"
        android:textColor="#FFFFFFFF"
        android:textSize="46sp"
        android:textStyle="bold"
        android:includeFontPadding="false" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="DAY STREAK"
        android:textColor="#A6FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.12" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/widget_today_pill"
        android:paddingLeft="12dp"
        android:paddingRight="14dp"
        android:paddingTop="7dp"
        android:paddingBottom="7dp">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="7dp"
            android:src="@drawable/ic_widget_play" />

        <TextView
            android:id="@+id/widget_today_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready — tap to play"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
