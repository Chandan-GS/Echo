<?xml version="1.0" encoding="utf-8"?>
<!-- Echo (1×1): the same pearl and count, with no room for a label. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="62dp"
        android:layout_height="62dp"
        android:layout_gravity="center">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_orb_disc" />

        <ImageView
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:contentDescription="Echo"
            android:src="@drawable/ic_widget_pearl" />

        <TextView
            android:id="@+id/orb_badge"
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:minWidth="22dp"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:textColor="@color/todo_widget_text"
            android:textSize="11.5sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>
</FrameLayout>
