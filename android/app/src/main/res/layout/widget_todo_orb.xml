<?xml version="1.0" encoding="utf-8"?>
<!-- Echo To-do Progress (2×2): a progress ring with the count, and what's next. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_todo_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="92dp">

        <ImageView
            android:id="@+id/orb_ring"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/orb_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:fontFamily="@font/old_standard_tt_bold"
            android:includeFontPadding="false"
            android:textColor="@color/todo_widget_text"
            android:textSize="28sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/orb_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/todo_widget_text2"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/orb_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/todo_widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
