<?xml version="1.0" encoding="utf-8"?>
<!-- Echo To-do Progress (2×2): a progress ring with the count, and what's next.
     Every colour comes from resources so it follows light / dark mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_todo_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="14dp">

    <FrameLayout
        android:layout_width="92dp"
        android:layout_height="92dp">

        <ProgressBar
            android:id="@+id/orb_ring"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:indeterminate="false"
            android:max="100"
            android:progressDrawable="@drawable/todo_ring_progress" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="bottom"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/orb_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/old_standard_tt_bold"
                android:includeFontPadding="false"
                android:textColor="@color/todo_widget_text"
                android:textSize="28sp" />

            <TextView
                android:id="@+id/orb_total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/old_standard_tt_bold"
                android:includeFontPadding="false"
                android:textColor="@color/todo_widget_text2"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/orb_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/todo_widget_text2"
        android:textSize="12.5sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/orb_next_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:textColor="@color/todo_widget_green"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/orb_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/todo_widget_text"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
