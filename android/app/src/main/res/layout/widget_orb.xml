<?xml version="1.0" encoding="utf-8"?>
<!-- Echo (2×2 and up): the pearl on a soft disc, with how many are waiting. It
     has no card of its own and sits right on the wallpaper, so the label has a
     shadow to stay readable on bright ones. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/orb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="86dp"
        android:layout_height="86dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_orb_disc" />

        <ImageView
            android:layout_width="70dp"
            android:layout_height="70dp"
            android:layout_gravity="center"
            android:contentDescription="Echo"
            android:src="@drawable/ic_widget_pearl" />

        <TextView
            android:id="@+id/orb_badge"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:gravity="center"
            android:minWidth="26dp"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:textColor="@color/todo_widget_text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/orb_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:shadowColor="#73000000"
        android:shadowDy="1"
        android:shadowRadius="3"
        android:text="Echo"
        android:textColor="#D9FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
